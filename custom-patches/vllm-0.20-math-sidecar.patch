+async def _call_math_sidecar(
+    endpoint: str, activations: Mapping[int, Any]
+) -> dict[int | str, Any]:
+    import logging
+    import os
+
+    import msgpack
+    import numpy as np
+    import torch
+    import zmq
+    import zmq.asyncio
+
+    timeout_ms = int(os.environ.get("MATH_SIDECAR_TIMEOUT_MS", "5000"))
+    logger = logging.getLogger("vllm.math_sidecar_client")
+
+    encoded: dict[int, dict[str, Any]] = {}
+    for layer_idx, activation in activations.items():
+        if isinstance(activation, torch.Tensor):
+            array = activation.detach().cpu().to(dtype=torch.float32).numpy()
+        else:
+            array = np.asarray(activation, dtype="float32")
+        encoded[int(layer_idx)] = {
+            "shape": list(array.shape),
+            "dtype": str(array.dtype),
+            "data": array.tobytes(),
+        }
+
+    ctx = zmq.asyncio.Context.instance()
+    socket = ctx.socket(zmq.REQ)
+    socket.setsockopt(zmq.LINGER, 0)
+    socket.setsockopt(zmq.RCVTIMEO, timeout_ms)
+    socket.setsockopt(zmq.SNDTIMEO, timeout_ms)
+    try:
+        socket.connect(endpoint)
+        await socket.send(
+            msgpack.packb(
+                {"req_id": "", "activations": encoded}, use_bin_type=True
+            )
+        )
+        raw = await socket.recv()
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("math sidecar call failed: %s", exc)
+        return {"math_result": None, "error": f"{type(exc).__name__}: {exc}"}
+    finally:
+        socket.close(linger=0)
+
+    reply = msgpack.unpackb(raw, raw=False)
+    if "error" in reply:
+        return {"math_result": None, "error": str(reply["error"])}
+    return {"math_result": reply.get("math_result")}
